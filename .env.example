# Copy to .env and adjust. All values have working defaults for local dev.

# Database: SQLite by default. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/taskflow
DATABASE_URL=sqlite:///./taskflow.db

# JWT signing secret - use a long random value in production
SECRET_KEY=dev-only-change-me-in-production

# Access token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
